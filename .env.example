# Supabase Database URLs (Get these from Supabase -> Project Settings -> Database)
# 1. Transaction Pooler (Port 6543) - Used for serverless queries on Vercel
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Session / Direct Connection (Port 5432) - Used for Prisma migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Application Secrets
JWT_SECRET="aiesec_super_secret_jwt_key_2026"
ADMIN_CODE="AIESEC2026"

# Optional AI engine
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# AIESEC GIS Live GraphQL API Token (EXPA Personal Access Token)
AIESEC_GIS_TOKEN="3Zy3WdCwUE70rJBIlJ-AHTsjdmZQJrz7o8BgUi3TIdk"
